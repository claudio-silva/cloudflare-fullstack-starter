#!/usr/bin/env bash
# Versioned production deploy: bump package.json, deploy to Cloudflare, then tag + push.
#
# The release version lives in package.json (committed on main) and is baked into the build
# by vite.config.ts, so any builder — this script or a future Cloudflare Workers Builds
# pipeline — produces the same version without needing git tags at build time.
# The git tag vX.Y.Z always points at the commit that carries that package.json version.
#
# NEVER run this against production without explicit approval.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
export PATH="$ROOT/node_modules/.bin:$PATH"

usage() {
  cat <<'EOF2'
Usage: bin/deploy-production [options]

Deploys the current main to production (build, deploy, then database migrations) and tags the release.

If HEAD is already tagged vX.Y.Z, that version is redeployed and nothing is bumped.
Otherwise the next version is proposed (default: patch; first release: v1.0.0),
package.json is bumped in a "Release vX.Y.Z" commit, the Worker is built and deployed,
and only after that succeeds are main and the annotated tag pushed. A failed build or
deploy leaves no commit or tag behind. Migrations run last, once the new code is live;
if they fail the release stays tagged (it is live) and the script exits non-zero.

Options:
  --patch | --minor | --major   Bump kind (default: --patch)
  --version, -v vX.Y.Z          Use this exact version (must be newer than the latest tag)
  --yes, -y                     Do not prompt
  --release-only                Bump, commit, tag and push; do not deploy
                                (for when Workers Builds does the deploy)
  --dry-run                     Show the plan; change nothing
  --help, -h
EOF2
}

BUMP=patch; VERSION=""; YES=false; RELEASE_ONLY=false; DRY=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --minor|--patch|--major) BUMP="${1#--}"; shift ;;
    --version|-v) VERSION="${2:-}"; [[ -n "$VERSION" ]] || { echo "$1 needs a value" >&2; exit 1; }; shift 2 ;;
    --yes|-y) YES=true; shift ;;
    --release-only) RELEASE_ONLY=true; shift ;;
    --dry-run) DRY=true; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "bin/deploy-production: unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

die() { echo "bin/deploy-production: $*" >&2; exit 1; }

latest_tag() { git tag --list 'v*.*.*' --sort=-v:refname | head -n 1; }

pkg_version() { node -p "require('./package.json').version"; }

bump() {
  local latest="$1" kind="$2" ma mi pa
  if [[ -z "$latest" ]]; then echo "v1.0.0"; return; fi
  [[ "$latest" =~ ^v([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || die "cannot bump non-semver tag ${latest}"
  ma="${BASH_REMATCH[1]}"; mi="${BASH_REMATCH[2]}"; pa="${BASH_REMATCH[3]}"
  case "$kind" in
    major) echo "v$((ma + 1)).0.0" ;;
    minor) echo "v${ma}.$((mi + 1)).0" ;;
    patch) echo "v${ma}.${mi}.$((pa + 1))" ;;
  esac
}

# --- Preconditions -----------------------------------------------------------
branch="$(git rev-parse --abbrev-ref HEAD)"
[[ "$branch" == "main" ]] || die "production releases are cut from main (on ${branch})"
if [[ -n "$(git status --porcelain)" ]]; then
  git status --short >&2
  $DRY && echo "warning: working tree not clean (would abort a real run)" >&2 || die "working tree must be clean"
fi
git fetch origin --tags --quiet
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] || die "main differs from origin/main; pull/push first"
if ! $RELEASE_ONLY; then
  [[ -f .env.production ]] || die "missing .env.production"
fi

# --- Version -----------------------------------------------------------------
orig_sha="$(git rev-parse HEAD)"
head_tag="$(git tag --points-at HEAD --list 'v*.*.*' --sort=-v:refname | head -n 1)"
latest="$(latest_tag)"
new_commit=false
if [[ -n "$head_tag" ]]; then
  [[ -z "$VERSION" || "$VERSION" == "$head_tag" ]] || die "HEAD is already ${head_tag}; refusing to retag as ${VERSION}"
  version="$head_tag"
  [[ "v$(pkg_version)" == "$version" ]] || die "package.json (v$(pkg_version)) does not match tag ${version}"
  tag_needed=false
  echo "HEAD is already ${version}; redeploying it."
else
  tag_needed=true
  if [[ -n "$VERSION" ]]; then
    version="v${VERSION#v}"
    [[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "version must be vX.Y.Z (got ${VERSION})"
    if [[ -n "$latest" && "$(printf '%s\n%s\n' "$latest" "$version" | sort -V | tail -n 1)" != "$version" || "$version" == "$latest" ]]; then
      die "${version} is not newer than latest tag ${latest}"
    fi
  else
    version="$(bump "$latest" "$BUMP")"
  fi
  [[ "v$(pkg_version)" == "$version" ]] || new_commit=true
fi

echo "Latest tag : ${latest:-<none>}"
echo "Release    : ${version} ($(git rev-parse --short HEAD))"
echo "Deploy     : $($RELEASE_ONLY && echo none \(release-only\) || echo "production (sync secrets + build vars, build, deploy, migrate)")"
echo "Steps      : $($new_commit && echo "bump package.json + commit; ")$($RELEASE_ONLY || echo "deploy; ")$($tag_needed && echo "tag + push main/tag")"
$DRY && { echo "(dry run — nothing changed)"; exit 0; }

if ! $YES; then
  read -r -p "Proceed with ${version}? [y/N] " ans
  [[ "$ans" == "y" || "$ans" == "Y" ]] || die "aborted"
fi

# --- Release -----------------------------------------------------------------
rollback() {
  if $new_commit; then
    echo "Deploy failed; dropping local release commit." >&2
    git reset --hard "$orig_sha" >/dev/null
  fi
}

if $new_commit; then
  npm pkg set version="${version#v}" >/dev/null
  git commit -q -am "Release ${version}"
fi

if ! $RELEASE_ONLY; then
  tsx bin/sync-secrets.ts production \
    && tsx bin/sync-build-vars.ts production \
    && npm run build:production \
    && wrangler deploy || { rollback; exit 1; }
fi

if $tag_needed; then
  git tag -a "$version" -m "$version"
  git push origin main
  git push origin "$version"
  echo "Tagged ${version} ($(git rev-parse --short "$version"))"
fi
if ! $RELEASE_ONLY; then
  # Migrations run through the Worker, so they come after the deploy. The release is already live
  # (and tagged above); a failure here must be loud, not silent.
  tsx bin/db.ts migrate --env production --safe --wait-for-deploy || {
    echo "bin/deploy-production: ${version} is live but its migrations FAILED. Fix and run: npm run db:migrate:production:safe" >&2
    exit 1
  }
fi
echo "Done: ${version}"
