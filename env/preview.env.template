# ====================================================================
# .env.preview template
# ====================================================================
ENVIRONMENT=preview

# Public base URL of the preview environment (used by Better Auth)
APP_BASE_URL=https://preview.example.com

# Better Auth signing/encryption secret. REQUIRED for preview/production.
# Use a different value per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Shared secret for the management CLI (`npm run auth ...`). Must match the
# CLI_API_KEY deployed to the preview worker. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CLI_API_KEY=

# CLI API URL override (optional)
CLI_API_URL_PREVIEW=https://preview.example.com
