# ====================================================================
# .env.local template
# ====================================================================
ENVIRONMENT=local

# Force Better Auth verification/reset emails in local development.
# wrangler.toml uses remote=true on the EMAIL binding so local sends are delivered.
AUTH_EMAILS_LOCAL_ENABLED=false

# Better Auth signing/encryption secret. REQUIRED for preview/production.
# Use a different value per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Shared secret for the management CLI (`npm run auth ...`). Must match the
# CLI_API_KEY configured on the worker. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CLI_API_KEY=

# CLI API URL overrides (optional)
CLI_API_URL=http://localhost:5173
